@toplevel
@strict

@fileinclude @ignore "opts.smk"

$PRETTYFTOA_SUBMODULE ?= @true
$STREAMINGATOF_SUBMODULE ?= @true
$CC ?= "cc"

# -Wstack-protector would be good but it requires -fstack-protector
# -Wcast-align=strict prevents CONTAINER_OF macro from working
# -Winline too noisy
$MYCFLAGS = ["-g", "-O2", "-Wall", "-Wextra", "-Wsign-conversion", "-Wno-missing-field-initializers", "-Wno-unused-parameter", "-Wshadow", "-Wstrict-prototypes", "-Wmissing-prototypes", "-Wpointer-arith", "-Wuninitialized", "-Wconversion", "-Wdeclaration-after-statement", "-Wbad-function-cast", "-Wdangling-else", "-Wold-style-definition", "-Wmissing-declarations", "-Wredundant-decls", "-Wnested-externs", "-Werror", "-std=gnu11", "-fPIC"]
@if (@strcmp($CC, "clang") != 0)
  $MYCFLAGS = [@$MYCFLAGS, "-Walloc-zero", "-Wjump-misses-init", "-Wlogical-op", "-Wrestrict"]
@endif
$CFLAGS ?= $MYCFLAGS

$CFLAGSINC = ["-I/usr/local/include"]

$(SRC_LIB) = ["caj.c", "caj_out.c"]
$(SRC_PROG) = ["main.c", "pullmain.c", "outmain.c", "fast_json_pp.c"]

$(SRC) = [@$(SRC_LIB), @$(SRC_PROG)]
$(OBJ_LIB) = @sufsuball($(SRC_LIB), ".c", ".o")
$(OBJ) = @sufsuball($(SRC), ".c", ".o")
$(DEP) = @sufsuball($(SRC), ".c", ".d")
$(PROG) = @sufsuball($(SRC_PROG), ".c", "")

$(LDFLAGS_DYN) = ["-L/usr/local/lib", "-Wl,-rpath,/usr/local/lib"]
$(RM) = "rm"
$(LN) = "ln"

$(SUBMODULES) = []
@if ($PRETTYFTOA_SUBMODULE)
  $(SUBMODULES) += ["prettyftoa/all"]
  $CFLAGSINC += ["-Iprettyftoa"]
@endif
@if ($STREAMINGATOF_SUBMODULE)
  $(SUBMODULES) += ["streamingatof/all"]
  $CFLAGSINC += ["-Istreamingatof"]
@endif

$(LIBS) = []
$(LIBSDYN) = []

@if ($STREAMINGATOF_SUBMODULE)
  $(LIBS) += ["streamingatof/libstreamingatof.a"]
@else
  $(LIBSDYN) += ["-lstreamingatof"]
@endif
@if ($PRETTYFTOA_SUBMODULE)
  $(LIBS) += ["prettyftoa/libprettyftoa.a"]
@else
  $(LIBSDYN) += ["-lprettyftoa"]
@endif

@phonyrule: 'all': 'libcaj.a' 'libcaj.so' 'libcaj.so.1' $(PROG) 'cajun/all' $(SUBMODULES)

@patrule: $(PROG): '%': '%.o' 'libcaj.a' $(LIBS)
@	[$(CC), @$(CFLAGS), @$(CFLAGSINC), @$(LDFLAGS_DYN), "-o", $@, $<, 'libcaj.a', @$(LIBS), @$(LIBSDYN)]

@patrule: $(OBJ): '%.o': '%.c' '%.d'
@	[$(CC), @$(CFLAGS), @$(CFLAGSINC), "-c", "-o", $@, $<]

@patrule: $(DEP): '%.d': '%.c'
@	[$(CC), @$(CFLAGS), @$(CFLAGSINC), "-MM", "-o", $@, $<]

'libcaj.a': $(OBJ_LIB)
@	["rm", "-f", $@]
@	["ar", "rvs", $@, @@suffilter($^, ".o")]

'libcaj.so.1': 'libcaj.a'
@	[$(CC), @$(CFLAGS), "-shared", "-o", $@, "-Wl,--whole-archive", @@suffilter($^, ".a"), "-Wl,--no-whole-archive", @$(LDFLAGS_DYN), "-lc"]

'libcaj.so': 'libcaj.so.1'
@	[$(RM), "-f", $@]
@	[$(LN), "-s", $<, $@]

@cdepincludes @autophony @autotarget @ignore [@$(DEP)]

@dirinclude "cajun"
@if ($PRETTYFTOA_SUBMODULE)
 @beginholeyscope
  $CC = @LP$CC
  $CFLAGS = @LP$CFLAGS
  @projdirinclude "prettyftoa"
 @endscope
@endif
@if ($STREAMINGATOF_SUBMODULE)
 @beginholeyscope
  $CC = @LP$CC
  $CFLAGS = @LP$CFLAGS
  @projdirinclude "streamingatof"
 @endscope
@endif
