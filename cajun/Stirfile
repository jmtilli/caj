@subfile
@strict

$(SRC_LIB) = ["cajun.c", "cajunfrag.c", "cajrbtree.c"]
$(SRC_PROG) = ["cajuntest.c", "cajunfragtest.c"]

$(SRC) = [@$(SRC_LIB), @$(SRC_PROG)]
$(OBJ_LIB) = @sufsuball($(SRC_LIB), ".c", ".o")
$(OBJ) = @sufsuball($(SRC), ".c", ".o")
$(DEP) = @sufsuball($(SRC), ".c", ".d")
$(PROG) = @sufsuball($(SRC_PROG), ".c", "")
$(LIBS) = ["../libcaj.a"]
$(LIBSDYN) = []
$(CFLAGS) = [@$(CFLAGS)]

@if ($STREAMINGATOF_SUBMODULE)
  $CFLAGS += ["-I../streamingatof"]
  $(LIBS) += ["../streamingatof/libstreamingatof.a"]
@else
  $(LIBSDYN) += ["-lstreamingatof"]
@endif
@if ($PRETTYFTOA_SUBMODULE)
  $(LIBS) += ["../prettyftoa/libprettyftoa.a"]
@else
  $(LIBSDYN) += ["-lprettyftoa"]
@endif

@phonyrule: 'all': 'libcajun.a' 'libcajun.so' 'libcajun.so.1' $(PROG)

@patrule: $(PROG): '%': '%.o' 'libcajun.a' $(LIBS)
@	[$(CC), @$(CFLAGS), @$(LDFLAGS_DYN), "-o", $@, $<, 'libcajun.a', @$(LIBS), @$(LIBSDYN)]

@patrule: $(OBJ): '%.o': '%.c' '%.d'
@	[$(CC), @$(CFLAGS), "-c", "-o", $@, $<]

@patrule: $(DEP): '%.d': '%.c'
@	[$(CC), @$(CFLAGS), "-MM", "-o", $@, $<]

'libcajun.a': $(OBJ_LIB)
@	["rm", "-f", $@]
@	["ar", "rvs", $@, @@suffilter($^, ".o")]

'libcajun.so.1': 'libcajun.a' '../libcaj.so'
@	[$(CC), @$(CFLAGS), @$(LDFLAGS_DYN), "-shared", "-o", $@, "-Wl,--whole-archive", @@suffilter($^, ".a"), "-Wl,--no-whole-archive", @$(LDFLAGS_DYN), "-lc", "-L..", "-lcaj"]

'libcajun.so': 'libcajun.so.1'
@	["rm", "-f", $@]
@	[$(LN), "-s", $<, $@]

@cdepincludes @autophony @autotarget @ignore [@$(DEP)]
